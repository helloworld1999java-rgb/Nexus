<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.marketplace.controller.OrdersController"
      spacing="20" styleClass="page-container">

    <padding><Insets top="32" bottom="40" left="40" right="40"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="16">
        <Label text="Мои заказы" styleClass="page-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Фильтр:" styleClass="label-muted"/>
        <ComboBox fx:id="statusFilter" prefWidth="180"/>
    </HBox>

    <ProgressIndicator fx:id="loadingIndicator" prefWidth="40" prefHeight="40" visible="false"/>
    <Label fx:id="emptyLabel" text="У вас пока нет заказов" styleClass="empty-label" visible="false" managed="false"/>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
        <VBox fx:id="ordersBox" spacing="16" maxWidth="900"/>
    </ScrollPane>
</VBox>

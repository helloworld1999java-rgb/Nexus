<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.marketplace.controller.dialog.PromoCodeDialogController"
      styleClass="dialog-root"
      spacing="0">

    <VBox styleClass="dialog-header" spacing="4">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="🏷️" styleClass="dialog-icon"/>
            <VBox spacing="2">
                <Label fx:id="dialogTitleLabel" text="Новый промокод" styleClass="dialog-title"/>
                <Label text="Заполните данные промокода" styleClass="dialog-subtitle"/>
            </VBox>
        </HBox>
    </VBox>

    <VBox styleClass="dialog-form" spacing="14">

        <VBox spacing="4">
            <Label text="КОД ПРОМОКОДА" styleClass="field-label"/>
            <HBox styleClass="input-wrapper" alignment="CENTER_LEFT" spacing="8">
                <Label text="🔖" styleClass="input-icon"/>
                <TextField fx:id="codeField"
                           styleClass="styled-input"
                           promptText="Например: SALE20"
                           HBox.hgrow="ALWAYS"/>
            </HBox>
            <Label fx:id="codeError" styleClass="field-error" text="" visible="false" managed="false"/>
        </VBox>

        <HBox spacing="12">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="ТИП СКИДКИ" styleClass="field-label"/>
                <ComboBox fx:id="typeBox" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="РАЗМЕР СКИДКИ" styleClass="field-label"/>
                <HBox styleClass="input-wrapper" alignment="CENTER_LEFT" spacing="8">
                    <Label text="%" styleClass="input-icon"/>
                    <TextField fx:id="valueField"
                               styleClass="styled-input"
                               promptText="0"
                               HBox.hgrow="ALWAYS"/>
                </HBox>
                <Label fx:id="valueError" styleClass="field-error" text="" visible="false" managed="false"/>
            </VBox>
        </HBox>

        <HBox spacing="12">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="МИН. СУММА ЗАКАЗА (₽)" styleClass="field-label"/>
                <HBox styleClass="input-wrapper" alignment="CENTER_LEFT" spacing="8">
                    <Label text="₽" styleClass="input-icon"/>
                    <TextField fx:id="minField"
                               styleClass="styled-input"
                               promptText="0 — без ограничений"
                               HBox.hgrow="ALWAYS"/>
                </HBox>
                <Label fx:id="minError" styleClass="field-error" text="" visible="false" managed="false"/>
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="МАКС. ИСПОЛЬЗОВАНИЙ" styleClass="field-label"/>
                <HBox styleClass="input-wrapper" alignment="CENTER_LEFT" spacing="8">
                    <Label text="∞" styleClass="input-icon"/>
                    <TextField fx:id="maxUsesField"
                               styleClass="styled-input"
                               promptText="0 — без ограничений"
                               HBox.hgrow="ALWAYS"/>
                </HBox>
                <Label fx:id="maxUsesError" styleClass="field-error" text="" visible="false" managed="false"/>
            </VBox>
        </HBox>

        <VBox spacing="4">
            <Label text="СРОК ДЕЙСТВИЯ (необязательно)" styleClass="field-label"/>
            <HBox styleClass="input-wrapper" alignment="CENTER_LEFT" spacing="8">
                <Label text="📅" styleClass="input-icon"/>
                <TextField fx:id="validField"
                           styleClass="styled-input"
                           promptText="ГГГГ-ММ-ДД"
                           HBox.hgrow="ALWAYS"/>
            </HBox>
            <Label fx:id="validError" styleClass="field-error" text="" visible="false" managed="false"/>
        </VBox>

        <HBox fx:id="activeRow" spacing="8" alignment="CENTER_LEFT" styleClass="checkbox-row">
            <CheckBox fx:id="activeBox" styleClass="styled-checkbox" selected="true"/>
            <Label text="Промокод активен" styleClass="checkbox-label"/>
        </HBox>

    </VBox>

    <HBox styleClass="dialog-footer" alignment="CENTER_RIGHT" spacing="10">
        <Button fx:id="cancelBtn" text="Отмена" styleClass="btn-cancel" onAction="#onCancel"/>
        <Button fx:id="saveBtn" text="Сохранить" styleClass="btn-primary" onAction="#onSave"/>
    </HBox>

</VBox>
